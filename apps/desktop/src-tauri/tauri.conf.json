{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Datowl",
  "mainBinaryName": "Datowl",
  "version": "0.1.0",
  "identifier": "dev.datowl.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../web/dist",
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Datowl",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassClear",
            "underWindowBackground"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "IDE base de donn\u00e9es pour PostgreSQL et ClickHouse",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENzIzNDg2OURFNkE5RTgKUldUb3FlYWRoalJ5L1FkUzRGdTV2elQ5cmJYMDhVSDhDdzlFYmE1Z1B1SUYxVFdoVlRiUTBPbFIK",
      "endpoints": [
        "https://github.com/lsalenson/datowl/releases/latest/download/latest.json"
      ]
    }
  }
}
