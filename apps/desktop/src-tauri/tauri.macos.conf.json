{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Datowl",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "liquidGlassClear",
            "underWindowBackground"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
